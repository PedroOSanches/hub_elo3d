{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "frontend": {
            "root": "frontend",
            "entrypoint": "iac/Dockerfile"
        },
        "backend": {
            "root": "backend",
            "framework": "fastapi",
            "entrypoint": "src.app.app:app"
        }
},
"rewrites": [
    {
        "source": "/api/(.*)",
        "destination": {
        "service": "backend"
        }
    },
    {
        "source": "/(.*)",
        "destination": {
        "service": "frontend"
        }
    }
]
}